pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        DOCKER_IMAGE = 'pdgamersg/noticeboard-app'
        APP_DIR = 'q1-notice-board'
        DOCKER_HOST = 'npipe:////./pipe/dockerDesktopLinuxEngine'
        DOCKER_CONFIG = "${WORKSPACE}\\.docker-build-${BUILD_NUMBER}"
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;C:\\ProgramData\\chocolatey\\bin;C:\\Program Files\\Git\\cmd;${env.PATH}"
    }
    stages {
        stage('Clone Code') {
            steps {
                retry(3) {
                    git branch: 'main', url: 'https://github.com/PDGamerSG/24MIS0212-Lab-Assessment-8.git'
                }
            }
        }
        stage('Build Docker Image') {
            steps { bat 'docker build -t %DOCKER_IMAGE%:%BUILD_NUMBER% -t %DOCKER_IMAGE%:latest %APP_DIR%' }
        }
        stage('Test Application') {
            steps {
                bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci/Test-Container.ps1 -Image %DOCKER_IMAGE%:%BUILD_NUMBER% -AppDirectory %APP_DIR% -Port 8101 -ContainerName assessment-q1-%BUILD_NUMBER%'
            }
        }
        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat '''@echo off
echo %DOCKER_PASS%|docker login --username %DOCKER_USER% --password-stdin
exit /b %ERRORLEVEL%
'''
                    retry(3) {
                        timeout(time: 4, unit: 'MINUTES') {
                            bat '''@echo off
docker push %DOCKER_IMAGE%:%BUILD_NUMBER%
if errorlevel 1 exit /b 1
docker push %DOCKER_IMAGE%:latest
exit /b %ERRORLEVEL%
'''
                        }
                    }
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kuberconfig', variable: 'KUBECONFIG')]) {
                    bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci/Deploy.ps1 -Image %DOCKER_IMAGE%:%BUILD_NUMBER% -AppDirectory %APP_DIR% -Deployment noticeboard-deployment -Label noticeboard -Replicas 2 -NodePort 30001'
                }
            }
        }
        stage('Verify NodePort') {
            steps {
                bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci/Test-Page.ps1 -Url http://localhost:30001 -AppDirectory %APP_DIR%'
                archiveArtifacts artifacts: 'evidence/*', fingerprint: true
            }
        }
    }
    post { always { bat 'powershell -NoProfile -ExecutionPolicy Bypass -File ci/Cleanup.ps1' } }
}
