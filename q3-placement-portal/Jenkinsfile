pipeline {
    agent any

    environment {
        DOCKER_HUB_REPO = 'pdgamersg/placement-portal'
        IMAGE_TAG = 'latest'
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
    }

    stages {
        // Stage 1: Clone Code
        stage('Stage 1: Clone Code') {
            steps {
                echo '=== STAGE 1: Cloning repository code from GitHub ==='
                checkout scm
            }
        }

        // Stage 2: Build Docker Image
        stage('Stage 2: Build Docker Image') {
            steps {
                echo '=== STAGE 2: Building Docker image for Placement Portal ==='
                dir('q3-placement-portal') {
                    sh "docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} ."
                }
            }
        }

        // Stage 3: Test Application
        stage('Stage 3: Test Application') {
            steps {
                echo '=== STAGE 3: Verifying Docker image configuration and Nginx syntax ==='
                sh "docker run --rm ${DOCKER_HUB_REPO}:${IMAGE_TAG} nginx -t"
            }
        }

        // Stage 4: Push Image
        stage('Stage 4: Push Image to Docker Hub') {
            steps {
                echo '=== STAGE 4: Authenticating with Docker Hub & Pushing Image ==='
                withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker push ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
                }
            }
        }

        // Stage 5: Deploy to Kubernetes
        stage('Stage 5: Deploy to Kubernetes') {
            steps {
                echo '=== STAGE 5: Applying Kubernetes Deployment (3 Replicas) & NodePort Service ==='
                dir('q3-placement-portal') {
                    sh 'kubectl apply -f deployment.yaml'
                    sh "kubectl rollout restart deployment/placement-deployment"
                }
            }
        }

        // Stage 6: Verify Deployment
        stage('Stage 6: Verify Deployment & Pod Status') {
            steps {
                echo '=== STAGE 6: Verifying 3 Kubernetes Pods and NodePort Service ==='
                sh 'kubectl rollout status deployment/placement-deployment'
                sh 'kubectl get pods -l app=placement-portal'
                sh 'kubectl get svc placement-service'
            }
        }
    }

    post {
        success {
            echo '✅ CI/CD Pipeline completed successfully! Application updated on Kubernetes.'
        }
        failure {
            echo '❌ CI/CD Pipeline failed. Check build logs for details.'
        }
    }
}
